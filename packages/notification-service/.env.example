NOTIFICATION_DATABASE_URL=postgresql://pgic:pgic@localhost:5432/notification_service
NOTIFICATION_SERVICE_PORT=3008
BASE_URL=http://localhost:3008
# Same secret as identity-service required for symmetric signing (HS256) so token verification works
JWT_SECRET=change-me-in-production-use-same-as-identity-service

# E-mail transacional (F1-08/F1-03)
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@seudominio.com
EMAIL_FROM_NAME=PGIC
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Em 587, deixe SMTP_SECURE=false e SMTP_REQUIRE_TLS=true para STARTTLS.
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_MESSAGE_TIMEOUT_MS=15000
