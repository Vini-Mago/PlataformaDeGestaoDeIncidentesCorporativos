{
  "uid": "pgic-operational-overview",
  "title": "PGIC Operational Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["pgic", "fase-2", "observability"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(up{job=~\"pgic-services|pgic-gateway\"})", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP request rate by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (service) (rate(pgic_http_requests_total[5m]))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP 5xx rate by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (service) (rate(pgic_http_requests_total{status_class=\"5xx\"}[5m]))", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP p95 latency by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (service, le) (rate(pgic_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Service uptime seconds",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "pgic_service_uptime_seconds", "legendFormat": "{{service}}", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    }
  ]
}
