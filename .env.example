# PostgreSQL (Docker Compose + connection strings for services)
POSTGRES_USER=pgic
POSTGRES_PASSWORD=pgic
POSTGRES_DB=identity_service
POSTGRES_PORT=55432

# Connection strings (one Postgres, one DB per service: {name}_service, snake_case).
# Use service-specific vars (IDENTITY_DATABASE_URL, REQUEST_DATABASE_URL) for each service.
# DATABASE_URL: generic/fallback DB URL used by tests or scripts that need a single default (e.g. request_service).
DATABASE_URL=postgresql://pgic:pgic@localhost:55432/request_service
IDENTITY_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/identity_service
REQUEST_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/request_service
INCIDENT_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/incident_service
PROBLEM_CHANGE_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/problem_change_service
SLA_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/sla_service
ESCALATION_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/escalation_service
NOTIFICATION_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/notification_service
AUDIT_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/audit_service
REPORTING_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/reporting_service
INTEGRATION_DATABASE_URL=postgresql://pgic:pgic@localhost:55432/integration_service

# Redis
REDIS_URL=redis://localhost:56379
REDIS_PORT=56379

# RabbitMQ (Docker Compose)
RABBITMQ_USER=pgic
RABBITMQ_PASSWORD=pgic
RABBITMQ_PORT=55672
RABBITMQ_MANAGEMENT_PORT=55673
RABBITMQ_URL=amqp://pgic:pgic@localhost:55672
RABBITMQ_CONNECT_RETRIES=20
RABBITMQ_CONNECT_RETRY_DELAY_MS=1500

# Portas dos serviços
IDENTITY_SERVICE_PORT=3201
REQUEST_SERVICE_PORT=3202
INCIDENT_SERVICE_PORT=3204
PROBLEM_CHANGE_SERVICE_PORT=3205
SLA_SERVICE_PORT=3206
ESCALATION_SERVICE_PORT=3207
NOTIFICATION_SERVICE_PORT=3208
AUDIT_SERVICE_PORT=3209
REPORTING_SERVICE_PORT=3210
INTEGRATION_SERVICE_PORT=3211
API_DOCS_PORT=3203
BFF_PORT=3300
FRONTEND_PORT=5173

# Nginx no Docker: porta no host (container escuta 80). Sem Docker use 80 no host.
GATEWAY_PORT=58080

# Identity: auth
JWT_SECRET=change-me-in-production-use-a-long-random-secret
JWT_EXPIRES_IN_SECONDS=604800
BASE_URL=http://localhost:3201
# Deixe vazio para usar origem pública dinâmica (frontend/ngrok) via BFF.
OAUTH_REDIRECT_URL=
OAUTH_REDIRECT_PATH=/auth/callback
PUBLIC_ORIGIN_OVERRIDE=
PUBLIC_ALLOWED_HOST_SUFFIXES=ngrok-free.dev,ngrok-free.app,ngrok.app,localhost
PASSWORD_AUTH_ENABLED=true
CORS_ORIGIN=
METRICS_TOKEN=change-me-metrics-token

# BFF
# BFF_COOKIE_SECURE: true|false para fixo, vazio para automático por request.
BFF_COOKIE_SECURE=
IDENTITY_BASE_URL=http://localhost:3201
REQUEST_SERVICE_BASE_URL=http://localhost:3202
INCIDENT_SERVICE_BASE_URL=http://localhost:3204
PROBLEM_CHANGE_SERVICE_BASE_URL=http://localhost:3205
SLA_SERVICE_BASE_URL=http://localhost:3206
ESCALATION_SERVICE_BASE_URL=http://localhost:3207
NOTIFICATION_SERVICE_BASE_URL=http://localhost:3208
AUDIT_SERVICE_BASE_URL=http://localhost:3209
REPORTING_SERVICE_BASE_URL=http://localhost:3210
INTEGRATION_SERVICE_BASE_URL=http://localhost:3211
INTEGRATION_SPEC_URL=http://localhost:3211/api-docs.json

# Usuarios seedados em desenvolvimento
DEV_SEED_DEFAULT_PASSWORD=Admin123!
DEV_SEED_ADMIN_EMAIL=admin@pgic.local
DEV_SEED_ADMIN_LOGIN=admin
DEV_SEED_ADMIN_PASSWORD=Admin123!
DEV_SEED_ADMIN_NAME=Administrador PGIC
DEV_SEED_ADMIN_PHONE=+55 11 90000-0000
DEV_SEED_ADMIN_DEPARTMENT=Operacoes de TI
DEV_SEED_ADMIN_JOB_TITLE=Administrador da Plataforma
DEV_SEED_ADMIN_LANGUAGE=pt-BR
DEV_SEED_ADMIN_TIME_ZONE=America/Sao_Paulo
DEV_SEED_MANAGER_EMAIL=gestor@pgic.local
DEV_SEED_MANAGER_LOGIN=gestor
DEV_SEED_ANALYST_EMAIL=analista@pgic.local
DEV_SEED_ANALYST_LOGIN=analista
DEV_SEED_NOC_EMAIL=noc@pgic.local
DEV_SEED_NOC_LOGIN=noc
DEV_SEED_USER_EMAIL=usuario@pgic.local
DEV_SEED_USER_LOGIN=usuario
DEV_SEED_INACTIVE_EMAIL=inativo@pgic.local
DEV_SEED_INACTIVE_LOGIN=inativo

# Integration-service (webhooks RF-9.x)
INTEGRATION_WEBHOOK_API_KEY=dev-integration-webhook-key
INTEGRATION_WEBHOOK_SECRET=
INTEGRATION_WEBHOOK_ALLOWED_IPS=
INTEGRATION_SYSTEM_USER_ID=00000000-0000-4000-8000-000000000001
SLA_EVALUATION_INTERVAL_MS=30000

FRONTEND_DEV_URL=http://localhost:5173
NGROK_DOMAIN=
NGROK_AUTHTOKEN=

# OAuth (opcional; deixe em branco para desativar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# E-mail transacional (F1-08/F1-03)
# Segredos devem vir de secret manager; nao versionar credenciais reais.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=noreply@seudominio.com
EMAIL_FROM_NAME=PGIC
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# Em 587, deixe SMTP_SECURE=false e SMTP_REQUIRE_TLS=true para STARTTLS.
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=<brevo-smtp-login>
SMTP_PASSWORD=<brevo-smtp-key>
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_MESSAGE_TIMEOUT_MS=15000
